# Stripe
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` (local) or the Dashboard webhook endpoint (production).
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase — Storage only (private "toolkits" bucket holds the PDFs).
# SECRET key is server-only; it signs private download URLs. Never expose it.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Site — used as a fallback origin for Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
